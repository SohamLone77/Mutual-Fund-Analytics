<?xml version='1.0' encoding='utf-8' ?>

<!-- ============================================================
     Bluestock Fintech — Mutual Fund Analytics Dashboard
     Tableau Workbook (.twb) — XML Format
     ============================================================
     Database : bluestock_mf.db (SQLite)
     Tables   : dim_fund, dim_date, dim_investor,
                fact_nav, fact_aum, fact_transactions,
                fact_performance, fact_nifty50
     
     IMPORTANT: Update the 'dbname' attribute below to the
     absolute path of your local bluestock_mf.db file.
     Example Windows path:
       C:/Users/YourName/path/to/data/db/bluestock_mf.db
     ============================================================
     Pages:
       1. Industry & AUM Overview    — KPIs, AUM bars, tx trend
       2. Fund Performance Scorecard — Risk-return, Sharpe, CAGR
       3. Investor Analytics         — Demographics, state inflows
       4. SIP & Market Trends        — SIP vs NIFTY, gap analysis
     ============================================================ -->

<workbook source-build='2024.1.0' source-platform='win'
          xmlns:user='http://www.tableausoftware.com/xml/user'>

  <!-- ── Colour Theme ───────────────────────────────────────── -->
  <preferences>
    <color-palette name='Bluestock Theme' type='regular'>
      <color>#4154f1</color>  <!-- Primary Blue   -->
      <color>#012970</color>  <!-- Dark Navy      -->
      <color>#F05537</color>  <!-- Accent Orange  -->
      <color>#059652</color>  <!-- Accent Green   -->
      <color>#f3268c</color>  <!-- Accent Pink    -->
      <color>#6c757d</color>  <!-- Neutral Grey   -->
    </color-palette>
  </preferences>

  <!-- ── Datasources (one per DB table) ────────────────────── -->
  <datasources>

    <!-- dim_fund -->
    <datasource caption='Dim Fund' name='dim_fund' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='dim_fund' table='[dim_fund]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[fund_key]'        role='dimension' type='integer' />
      <column name='[amfi_code]'       role='dimension' type='integer' />
      <column name='[scheme_name]'     role='dimension' type='string'  />
      <column name='[fund_house]'      role='dimension' type='string'  />
      <column name='[scheme_type]'     role='dimension' type='string'  />
      <column name='[scheme_category]' role='dimension' type='string'  />
      <column name='[isin_growth]'     role='dimension' type='string'  />
      <!-- Calculated: Risk Grade from category -->
      <column name='[Risk Grade]' role='dimension' type='string' datatype='string'>
        <calculation class='tableau' formula='
          IF CONTAINS(LOWER([scheme_category]), "debt") OR
             CONTAINS(LOWER([scheme_category]), "money market") OR
             CONTAINS(LOWER([scheme_category]), "gilt")
          THEN "Low"
          ELSEIF CONTAINS(LOWER([scheme_category]), "large cap") OR
                 CONTAINS(LOWER([scheme_category]), "elss") OR
                 CONTAINS(LOWER([scheme_category]), "index")
          THEN "Moderate"
          ELSE "High"
          END' />
      </column>
    </datasource>

    <!-- dim_date -->
    <datasource caption='Dim Date' name='dim_date' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='dim_date' table='[dim_date]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[date_key]'      role='dimension' type='integer'  />
      <column name='[calendar_date]' role='dimension' type='datetime' />
      <column name='[year]'          role='dimension' type='integer'  />
      <column name='[quarter]'       role='dimension' type='integer'  />
      <column name='[month]'         role='dimension' type='integer'  />
      <column name='[month_name]'    role='dimension' type='string'   />
      <column name='[day_name]'      role='dimension' type='string'   />
      <column name='[is_weekend]'    role='dimension' type='integer'  />
      <column name='[is_month_end]'  role='dimension' type='integer'  />
    </datasource>

    <!-- dim_investor -->
    <datasource caption='Dim Investor' name='dim_investor' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='dim_investor' table='[dim_investor]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[investor_id]'       role='dimension' type='string'  />
      <column name='[age_group]'         role='dimension' type='string'  />
      <column name='[gender]'            role='dimension' type='string'  />
      <column name='[state]'             role='dimension' type='string'  />
      <column name='[city_tier]'         role='dimension' type='string'  />
      <column name='[registration_date]' role='dimension' type='datetime'/>
      <column name='[sip_amount]'        role='measure'   type='real'    />
    </datasource>

    <!-- fact_nav -->
    <datasource caption='Fact NAV' name='fact_nav' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='fact_nav' table='[fact_nav]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[fact_nav_key]'   role='dimension' type='integer' />
      <column name='[fund_key]'       role='dimension' type='integer' />
      <column name='[date_key]'       role='dimension' type='integer' />
      <column name='[nav]'            role='measure'   type='real'    />
      <column name='[previous_nav]'   role='measure'   type='real'    />
      <column name='[nav_change]'     role='measure'   type='real'    />
      <column name='[nav_return_pct]' role='measure'   type='real'    />
    </datasource>

    <!-- fact_aum -->
    <datasource caption='Fact AUM' name='fact_aum' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='fact_aum' table='[fact_aum]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[aum_key]'           role='dimension' type='integer' />
      <column name='[fund_key]'          role='dimension' type='integer' />
      <column name='[date_key]'          role='dimension' type='integer' />
      <column name='[aum_value]'         role='measure'   type='real'    />
      <column name='[observation_count]' role='measure'   type='integer' />
      <column name='[min_nav]'           role='measure'   type='real'    />
      <column name='[max_nav]'           role='measure'   type='real'    />
    </datasource>

    <!-- fact_transactions -->
    <datasource caption='Fact Transactions' name='fact_transactions' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='fact_transactions' table='[fact_transactions]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[transaction_key]'      role='dimension' type='integer' />
      <column name='[fund_key]'             role='dimension' type='integer' />
      <column name='[transaction_date_key]' role='dimension' type='integer' />
      <column name='[investor_id]'          role='dimension' type='string'  />
      <column name='[transaction_type]'     role='dimension' type='string'  />
      <column name='[amount]'               role='measure'   type='real'    />
      <column name='[units]'                role='measure'   type='real'    />
      <column name='[state]'                role='dimension' type='string'  />
      <column name='[kyc_status]'           role='dimension' type='string'  />
      <!-- Calculated: SIP only flag -->
      <column name='[Is SIP]' role='dimension' type='boolean' datatype='boolean'>
        <calculation class='tableau' formula='[transaction_type] = "SIP"' />
      </column>
    </datasource>

    <!-- fact_performance -->
    <datasource caption='Fact Performance' name='fact_performance' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='fact_performance' table='[fact_performance]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[performance_key]' role='dimension' type='integer' />
      <column name='[fund_key]'        role='dimension' type='integer' />
      <column name='[date_key]'        role='dimension' type='integer' />
      <column name='[return_1m]'       role='measure'   type='real'    />
      <column name='[return_3m]'       role='measure'   type='real'    />
      <column name='[return_1y]'       role='measure'   type='real'    />
      <column name='[return_3y]'       role='measure'   type='real'    />
      <column name='[return_5y]'       role='measure'   type='real'    />
      <column name='[expense_ratio]'   role='measure'   type='real'    />
      <column name='[volatility]'      role='measure'   type='real'    />
      <column name='[sharpe_ratio]'    role='measure'   type='real'    />
      <column name='[anomaly_flag]'    role='dimension' type='integer' />
      <!-- Calculated: Sharpe quality label -->
      <column name='[Sharpe Category]' role='dimension' type='string' datatype='string'>
        <calculation class='tableau' formula='
          IF [sharpe_ratio] >= 1.0 THEN "Excellent (≥1.0)"
          ELSEIF [sharpe_ratio] >= 0.5 THEN "Good (0.5–1.0)"
          ELSEIF [sharpe_ratio] >= 0.0 THEN "Fair (0–0.5)"
          ELSE "Poor (<0)"
          END' />
      </column>
      <!-- Calculated: Return label -->
      <column name='[Return Label 1Y]' role='measure' type='string' datatype='string'>
        <calculation class='tableau' formula='
          STR(ROUND([return_1y], 2)) + "%"' />
      </column>
    </datasource>

    <!-- fact_nifty50 -->
    <datasource caption='Fact Nifty50' name='fact_nifty50' inline='true'>
      <connection class='sqlite'
        dbname='C:/Users/SOHAM/OneDrive/Desktop/Bluestock_Fintech/Mutual Fund Analytics/data/db/bluestock_mf.db'
        server='localhost'>
        <relation name='fact_nifty50' table='[fact_nifty50]' type='table' />
      </connection>
      <aliases enabled='yes' />
      <column name='[Number of Records]' datatype='integer' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column name='[nifty_key]'   role='dimension' type='integer' />
      <column name='[date_key]'    role='dimension' type='integer' />
      <column name='[nifty_close]' role='measure'   type='real'    />
    </datasource>

  </datasources>

  <!-- ── Worksheets ─────────────────────────────────────────── -->
  <worksheets>

    <!-- Sheet 1: AUM by Fund House (Bar) -->
    <worksheet name='AUM by Scheme'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_fund'>
            <column name='[fund_house]' />
            <column name='[scheme_name]' />
            <column name='[scheme_category]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_aum'>
            <column name='[aum_value]' />
          </datasource-dependencies>
          <filter class='categorical' column='[dim_fund].[fund_house]'>
            <groupfilter function='level-members' level='[fund_house]' />
          </filter>
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[dim_fund].[scheme_category]'
                      palette='bluestock-theme' type='palette' />
          </style-rule>
        </style>
      </table>
    </worksheet>

    <!-- Sheet 2: Monthly Transaction Trend (Line) -->
    <worksheet name='Monthly Transactions'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_date'>
            <column name='[year]' />
            <column name='[month]' />
            <column name='[month_name]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_transactions'>
            <column name='[amount]' />
            <column name='[transaction_type]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 3: Risk vs Return Scatter -->
    <worksheet name='Risk vs Return'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_fund'>
            <column name='[scheme_name]' />
            <column name='[scheme_category]' />
            <column name='[fund_house]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_performance'>
            <column name='[return_1y]' />
            <column name='[volatility]' />
            <column name='[sharpe_ratio]' />
            <column name='[return_3y]' />
            <column name='[return_5y]' />
            <column name='[Sharpe Category]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 4: Investor State Inflows (Horizontal Bar) -->
    <worksheet name='State Inflows'>
      <table>
        <view>
          <datasource-dependencies datasource='fact_transactions'>
            <column name='[state]' />
            <column name='[amount]' />
            <column name='[transaction_type]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 5: SIP vs Lumpsum Donut -->
    <worksheet name='SIP vs Lumpsum'>
      <table>
        <view>
          <datasource-dependencies datasource='fact_transactions'>
            <column name='[transaction_type]' />
            <column name='[amount]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 6: SIP Inflow + NIFTY Dual Axis -->
    <worksheet name='SIP and Market Trends'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_date'>
            <column name='[calendar_date]' />
            <column name='[year]' />
            <column name='[month]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_transactions'>
            <column name='[amount]' />
            <column name='[transaction_type]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_nifty50'>
            <column name='[nifty_close]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 7: NAV Historical Line Chart -->
    <worksheet name='NAV Trend'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_fund'>
            <column name='[scheme_name]' />
            <column name='[scheme_category]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='dim_date'>
            <column name='[calendar_date]' />
          </datasource-dependencies>
          <datasource-dependencies datasource='fact_nav'>
            <column name='[nav]' />
            <column name='[nav_return_pct]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

    <!-- Sheet 8: Age Group SIP Bar -->
    <worksheet name='Age Group SIP'>
      <table>
        <view>
          <datasource-dependencies datasource='dim_investor'>
            <column name='[age_group]' />
            <column name='[gender]' />
            <column name='[city_tier]' />
            <column name='[sip_amount]' />
            <column name='[state]' />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>

  </worksheets>

  <!-- ── Dashboards ─────────────────────────────────────────── -->
  <dashboards>

    <!-- Dashboard 1: Industry & AUM Overview -->
    <dashboard name='Page 1 - Industry Overview'>
      <style>
        <formatting />
      </style>
      <size maxheight='1080' maxwidth='1920' minheight='630' minwidth='800' />
      <zones>
        <zone h='100000' type='layout-basic' w='100000' x='0' y='0'>
          <!-- Row 1: Title -->
          <zone h='8000' type='title' w='100000' x='0' y='0' />
          <!-- Row 2: KPI cards (4 across) -->
          <zone h='20000' type='layout-flow' w='100000' x='0' y='8000'>
            <zone h='20000' name='[Total AUM KPI]'     type='text' w='25000' x='0'     y='8000' />
            <zone h='20000' name='[Folios KPI]'        type='text' w='25000' x='25000' y='8000' />
            <zone h='20000' name='[Transactions KPI]'  type='text' w='25000' x='50000' y='8000' />
            <zone h='20000' name='[Schemes KPI]'       type='text' w='25000' x='75000' y='8000' />
          </zone>
          <!-- Row 3: AUM Bar + Transaction Line -->
          <zone h='72000' type='layout-flow' w='100000' x='0' y='28000'>
            <zone h='72000' name='AUM by Scheme'        type='worksheet' w='50000' x='0'     y='28000' />
            <zone h='72000' name='Monthly Transactions' type='worksheet' w='50000' x='50000' y='28000' />
          </zone>
        </zone>
      </zones>
      <worksheetsAsDashboard value='false' />
      <widgets>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='50000' name='AUM by Scheme'        w='50000' x='0'     y='28000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='50000' name='Monthly Transactions'  w='50000' x='50000' y='28000' />
        </widget>
      </widgets>
    </dashboard>

    <!-- Dashboard 2: Fund Performance Scorecard -->
    <dashboard name='Page 2 - Fund Performance'>
      <style>
        <formatting />
      </style>
      <size maxheight='1080' maxwidth='1920' minheight='630' minwidth='800' />
      <zones>
        <zone h='100000' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' type='title' w='100000' x='0' y='0' />
          <!-- Filters row -->
          <zone h='10000' type='layout-flow' w='100000' x='0' y='8000'>
            <zone h='10000' name='[Fund House Filter]'   type='filter' w='33000' x='0'     y='8000' />
            <zone h='10000' name='[Category Filter]'     type='filter' w='33000' x='33000' y='8000' />
            <zone h='10000' name='[Sharpe Cat Filter]'   type='filter' w='34000' x='66000' y='8000' />
          </zone>
          <!-- Charts row 1 -->
          <zone h='45000' type='layout-flow' w='100000' x='0' y='18000'>
            <zone h='45000' name='Risk vs Return'  type='worksheet' w='55000' x='0'     y='18000' />
            <zone h='45000' name='NAV Trend'       type='worksheet' w='45000' x='55000' y='18000' />
          </zone>
          <!-- Charts row 2 -->
          <zone h='37000' name='Risk vs Return'   type='worksheet' w='100000' x='0' y='63000' />
        </zone>
      </zones>
      <worksheetsAsDashboard value='false' />
      <widgets>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='45000' name='Risk vs Return' w='55000' x='0'     y='18000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='45000' name='NAV Trend'      w='45000' x='55000' y='18000' />
        </widget>
      </widgets>
    </dashboard>

    <!-- Dashboard 3: Investor Analytics -->
    <dashboard name='Page 3 - Investor Analytics'>
      <style>
        <formatting />
      </style>
      <size maxheight='1080' maxwidth='1920' minheight='630' minwidth='800' />
      <zones>
        <zone h='100000' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' type='title' w='100000' x='0' y='0' />
          <!-- Filters -->
          <zone h='10000' type='layout-flow' w='100000' x='0' y='8000'>
            <zone h='10000' name='[State Filter]'     type='filter' w='33000' x='0'     y='8000' />
            <zone h='10000' name='[Age Group Filter]' type='filter' w='33000' x='33000' y='8000' />
            <zone h='10000' name='[City Tier Filter]' type='filter' w='34000' x='66000' y='8000' />
          </zone>
          <!-- Charts -->
          <zone h='82000' type='layout-flow' w='100000' x='0' y='18000'>
            <zone h='82000' name='State Inflows'  type='worksheet' w='50000' x='0'     y='18000' />
            <zone h='41000' name='SIP vs Lumpsum' type='worksheet' w='50000' x='50000' y='18000' />
            <zone h='41000' name='Age Group SIP'  type='worksheet' w='50000' x='50000' y='59000' />
          </zone>
        </zone>
      </zones>
      <worksheetsAsDashboard value='false' />
      <widgets>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='82000' name='State Inflows'  w='50000' x='0'     y='18000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='41000' name='SIP vs Lumpsum' w='50000' x='50000' y='18000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='41000' name='Age Group SIP'  w='50000' x='50000' y='59000' />
        </widget>
      </widgets>
    </dashboard>

    <!-- Dashboard 4: SIP & Market Trends -->
    <dashboard name='Page 4 - SIP and Market Trends'>
      <style>
        <formatting />
      </style>
      <size maxheight='1080' maxwidth='1920' minheight='630' minwidth='800' />
      <zones>
        <zone h='100000' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='8000' type='title' w='100000' x='0' y='0' />
          <!-- Filters -->
          <zone h='10000' type='layout-flow' w='100000' x='0' y='8000'>
            <zone h='10000' name='[Year Filter]'  type='filter' w='50000' x='0'     y='8000' />
            <zone h='10000' name='[Type Filter]'  type='filter' w='50000' x='50000' y='8000' />
          </zone>
          <!-- Main dual-axis chart -->
          <zone h='50000' name='SIP and Market Trends' type='worksheet' w='100000' x='0' y='18000' />
          <!-- Bottom row -->
          <zone h='32000' type='layout-flow' w='100000' x='0' y='68000'>
            <zone h='32000' name='SIP vs Lumpsum' type='worksheet' w='50000' x='0'     y='68000' />
            <zone h='32000' name='State Inflows'  type='worksheet' w='50000' x='50000' y='68000' />
          </zone>
        </zone>
      </zones>
      <worksheetsAsDashboard value='false' />
      <widgets>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='50000' name='SIP and Market Trends' w='100000' x='0' y='18000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='32000' name='SIP vs Lumpsum' w='50000' x='0'     y='68000' />
        </widget>
        <widget assemblyVersion='0' classname='TableauWorksheetWidget'>
          <zone h='32000' name='State Inflows'  w='50000' x='50000' y='68000' />
        </widget>
      </widgets>
    </dashboard>

  </dashboards>

</workbook>
